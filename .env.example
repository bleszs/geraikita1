# This file documents variables; npm start does not automatically load it.
# Local startup needs no variables. Configure these in the Railway dashboard.
NODE_ENV=production
BIND_HOST=0.0.0.0
# Omit PUBLIC_ORIGIN to derive HTTPS from Railway's generated public domain.
# PUBLIC_ORIGIN=https://your-service.up.railway.app
DATABASE_PATH=/data/gerai-kita.sqlite
FORECAST_MODEL_DIR=/data/models/forecast
# Enable only when all inbound traffic comes through Railway's trusted edge.
TRUST_RAILWAY_PROXY=true
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
# Use a private Ollama service; do not expose its unauthenticated API publicly.
OLLAMA_URL=http://ollama.railway.internal:11434
# Pilot quotas per business per Jakarta calendar month (zero disables AI usage).
# Manual bookkeeping, inventory and menu creation remain available.
FREE_AI_TEXT_MONTHLY=100
FREE_AI_SPEECH_MONTHLY=30
# PORT and RAILWAY_VOLUME_MOUNT_PATH are supplied by Railway.
